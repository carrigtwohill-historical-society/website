---
pagination:
  data: urlMap
  size: 1
  alias: redirect
eleventyExcludeFromCollections: true
permalink: "{{ redirect.old | safe }}/"
layout: false
---
<!DOCTYPE html>
<html lang="en-IE">
<head>
  <meta charset="utf-8">
  <title>Redirecting…</title>
  <link rel="canonical" href="{{ site.url }}{{ site.pathPrefix }}{{ redirect.new }}">
  <!-- Browser redirect only. GitHub Pages cannot send an HTTP 301. -->
  <script>
    var dest = "{{ site.pathPrefix }}{{ redirect.new }}";
    if (location.search && dest.indexOf("?") === -1) dest += location.search;
    if (location.hash && dest.indexOf("#") === -1) dest += location.hash;
    location.replace(dest);
  </script>
  <meta http-equiv="refresh" content="0;url={{ site.pathPrefix }}{{ redirect.new }}">
</head>
<body>
  <p>This page has moved to <a href="{{ site.pathPrefix }}{{ redirect.new }}">{{ redirect.title or redirect.new }}</a>.</p>
</body>
</html>
