---
title: Historical Map
description: Interactive map of historical places in Carrigtwohill parish, including the MTU/CIT village exhibit.
permalink: /map/
layout: layouts/base.njk
maplibre: true
bodyClass: map-page-body
---
<div class="map-page">
  <p class="map-skip"><a href="#map-places-panel">Skip map — view places as a list</a></p>

  <div class="map-shell">
    <button type="button" id="map-places-toggle" class="map-places-toggle" aria-expanded="false" aria-controls="map-places-panel">Places</button>
    <aside id="map-places-panel" class="map-places-panel" tabindex="-1">
      <div class="map-places-head">
        <h1 class="map-places-title">Historical Map</h1>
        <button type="button" id="map-places-close" class="map-places-close" aria-label="Close places list">Close</button>
      </div>
      <label class="map-places-filter-label" for="map-places-filter">Find a place</label>
      <input
        id="map-places-filter"
        class="map-places-filter"
        type="search"
        placeholder="Search places"
        autocomplete="off"
        spellcheck="false"
      >
      <div id="map-places-tree" class="map-places-tree" role="tree" aria-label="Places"></div>
      <div class="map-places-layers" role="group" aria-label="Map layers">
        <button type="button" id="map-basemap-toggle" class="btn map-ctrl-btn" aria-pressed="false">Show street map</button>
        <button type="button" id="map-townlands-toggle" class="btn map-ctrl-btn" aria-pressed="false">Show townland borders</button>
        <button type="button" id="map-townland-names-toggle" class="btn map-ctrl-btn" aria-pressed="false">Show townland names</button>
      </div>
      <p id="map-layer-hint" class="map-layer-hint" aria-live="polite">Satellite view · click a place to fly there</p>
      <p class="map-places-help">
        <a href="{{ '/about/contact-us/' | url }}">Help us enrich this map</a>
      </p>
    </aside>

    <div class="map-frame">
      <div id="chs-map" class="show-pin-labels" role="region" aria-label="Carrigtwohill historical map"></div>
      <div id="map-status" class="map-status">Loading map…</div>
    </div>
  </div>
</div>
