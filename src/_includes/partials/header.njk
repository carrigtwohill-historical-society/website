<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header" data-pagefind-ignore>
  <div class="header-bar">
    <a class="brand" href="{{ '/' | url }}">
      <img class="brand-mark" src="{{ '/assets/Styles/Images/CDHSLogo.png' | url }}" width="200" height="146" alt="">
      <span class="brand-text">
        <span class="brand-name">{{ site.name }}</span>
      </span>
    </a>

    <div class="header-aside">
      <div class="header-search" data-site-search>
        <form class="header-search-form" action="{{ '/search/' | url }}" method="get" role="search" data-search-form>
          <label class="visually-hidden" for="site-search-input">Search the site</label>
          <div class="header-search-field">
            <svg class="header-search-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/>
              <path d="M15.5 15.5L21 21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <input
              id="site-search-input"
              class="header-search-input"
              type="search"
              name="q"
              placeholder="Search the site"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              enterkeyhint="search"
              data-search-input
              aria-controls="site-search-results"
              aria-expanded="false"
              aria-autocomplete="list"
            >
            <button type="submit" class="header-search-submit">Search</button>
          </div>
        </form>
        <div
          id="site-search-results"
          class="header-search-results"
          data-search-results
          hidden
          role="listbox"
          aria-label="Search suggestions"
        ></div>
      </div>

      <div class="header-contact">
        <a class="header-email" href="mailto:{{ site.email }}">{{ site.email }}</a>
        <p class="header-note">For messages with attachments, please email us directly — the contact form does not accept file uploads.</p>
      </div>

      <div class="header-connect">
        <p class="header-connect-label">Connect</p>
        {% set socialClass = "social-nav-header" %}
        {% set socialLabel = "Social links" %}
        {% set showVimeo = true %}
        {% include "partials/social-icons.njk" %}
      </div>
    </div>
  </div>

  <nav id="site-nav" class="site-nav" aria-label="Primary" data-site-nav>
    <div class="nav-mobile-panel">
      <a class="btn btn-membership btn-membership-nav" href="{{ '/membership/current-membership/' | url }}">Join or Renew Membership</a>
    </div>
    <ul class="nav-list">
      {% for item in navigation %}
      <li class="nav-item{% if item.children %} has-children{% endif %}">
        {% if item.children %}
        <button type="button" class="nav-parent" data-nav-parent aria-expanded="false">
          <span>{{ item.label }}</span>
          <span class="nav-chevron" aria-hidden="true"></span>
        </button>
        <ul class="nav-sub">
          {% for child in item.children %}
          <li>
            {% if child.external %}
            <a href="{{ child.url }}" target="_blank" rel="noopener noreferrer">{{ child.label }}</a>
            {% else %}
            <a href="{{ child.url | url }}"{% if page.url | navActive(child.url) %} aria-current="page"{% endif %}>{{ child.label }}</a>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <a href="{{ item.url | url }}">{{ item.label }}</a>
        {% endif %}
      </li>
      {% endfor %}
      <li class="nav-item nav-map">
        <a class="nav-map-link" href="{{ '/map/' | url }}">Map</a>
      </li>
    </ul>
  </nav>
</header>
