<nav class="section-nav" aria-label="{{ sectionNavs[section].heading }}">
  <details class="section-nav-panel" open>
    <summary class="section-nav-summary">In this section</summary>
    <p class="section-nav-heading">{{ sectionNavs[section].heading }}</p>
    <ul class="section-nav-list">
      {% for item in sectionNavs[section].items %}
      <li>
        <a href="{{ item.url | url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
      </li>
      {% endfor %}
    </ul>
  </details>
</nav>
